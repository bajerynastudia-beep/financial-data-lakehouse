{
  "datasets": [
    {
      "name": "0a368fb0",
      "displayName": "P1_Rentownosc_i_ryzyko",
      "queryLines": [
        "SELECT\r\n",
        "    name AS spolka,\r\n",
        "    ROUND(cagr_pln * 100, 2) AS cagr_proc,\r\n",
        "    ROUND(volatility_pln * 100, 2) AS zmiennosc_proc,\r\n",
        "    ROUND(max_drawdown_pln * 100, 2) AS obsuniecie_proc,\r\n",
        "    ROUND(return_to_risk_pln, 2) AS zwrot_do_ryzyka\r\n",
        "FROM workspace.fin_gold.risk_return\r\n",
        "WHERE instrument_type = 'stock'\r\n",
        "ORDER BY cagr_pln DESC;"
      ]
    },
    {
      "name": "1656bca2",
      "displayName": "P2_Wycena_PE",
      "queryLines": [
        "SELECT\r\n",
        "    name AS spolka,\r\n",
        "    ROUND(pe_current, 1) AS pe_biezace,\r\n",
        "    ROUND(pe_median_hist, 1) AS pe_mediana_historyczna,\r\n",
        "    ROUND(pe_percentile_hist * 100, 0) AS percentyl_pe\r\n",
        "FROM workspace.fin_gold.valuation_snapshot\r\n",
        "WHERE pe_current IS NOT NULL\r\n",
        "ORDER BY percentyl_pe DESC;\r\n"
      ]
    },
    {
      "name": "f8bcc687",
      "displayName": "P3_Wplyw_USD_PLN",
      "queryLines": [
        "SELECT\r\n",
        "    name AS spolka,\r\n",
        "    ROUND(cagr_local * 100, 2) AS cagr_usd,\r\n",
        "    ROUND(cagr_pln * 100, 2) AS cagr_pln,\r\n",
        "    ROUND(fx_effect_cagr * 100, 2) AS efekt_walutowy_pp\r\n",
        "FROM workspace.fin_gold.risk_return\r\n",
        "WHERE instrument_type = 'stock'\r\n",
        "ORDER BY cagr_pln DESC;\r\n"
      ]
    },
    {
      "name": "a08bb18e",
      "displayName": "P4_Ryzyko_portfela",
      "queryLines": [
        "SELECT\r\n",
        "    date AS data,\r\n",
        "    ROUND(drawdown * 100, 2) AS obsuniecie_proc,\r\n",
        "    ROUND(rolling_volatility * 100, 2) AS zmiennosc_proc,\r\n",
        "    ROUND(value_pln, 2) AS wartosc_portfela\r\n",
        "FROM workspace.fin_gold.portfolio_daily\r\n",
        "ORDER BY date;\r\n"
      ]
    },
    {
      "name": "20ee2598",
      "displayName": "Monthly Portfolio Value and Currency Impact Summary",
      "queryLines": [
        "\r\n",
        "WITH miesieczne AS (\r\n",
        "    SELECT\r\n",
        "        date,\r\n",
        "        value_pln,\r\n",
        "        value_pln_fixed_fx,\r\n",
        "        fx_effect_pln,\r\n",
        "        ROW_NUMBER() OVER (\r\n",
        "            PARTITION BY DATE_TRUNC('MONTH', date)\r\n",
        "            ORDER BY date DESC\r\n",
        "        ) AS rn\r\n",
        "    FROM workspace.fin_gold.portfolio_daily\r\n",
        ")\r\n",
        "SELECT\r\n",
        "    date AS data,\r\n",
        "    ROUND(value_pln, 2) AS rzeczywista_wartosc_pln,\r\n",
        "    ROUND(value_pln_fixed_fx, 2) AS staly_kurs_pln,\r\n",
        "    ROUND(fx_effect_pln, 2) AS efekt_walutowy_pln\r\n",
        "FROM miesieczne\r\n",
        "WHERE rn = 1\r\n",
        "ORDER BY data;\r\n"
      ]
    },
    {
      "name": "6b7da59d",
      "displayName": "P3_Wartosc_portfela_waluty",
      "queryLines": [
        "WITH miesieczne AS (\r\n",
        "    SELECT\r\n",
        "        date,\r\n",
        "        value_pln,\r\n",
        "        value_pln_fixed_fx,\r\n",
        "        fx_effect_pln,\r\n",
        "        ROW_NUMBER() OVER (\r\n",
        "            PARTITION BY DATE_TRUNC('MONTH', date)\r\n",
        "            ORDER BY date DESC\r\n",
        "        ) AS rn\r\n",
        "    FROM workspace.fin_gold.portfolio_daily\r\n",
        ")\r\n",
        "SELECT\r\n",
        "    date AS data,\r\n",
        "    ROUND(value_pln, 2) AS rzeczywista_wartosc_pln,\r\n",
        "    ROUND(value_pln_fixed_fx, 2) AS staly_kurs_pln,\r\n",
        "    ROUND(fx_effect_pln, 2) AS efekt_walutowy_pln\r\n",
        "FROM miesieczne\r\n",
        "WHERE rn = 1\r\n",
        "ORDER BY data;\r\n"
      ]
    },
    {
      "name": "9b2541d9",
      "displayName": "KPI_Portfel",
      "queryLines": [
        "WITH ostatni AS (\r\n",
        "    SELECT\r\n",
        "        date,\r\n",
        "        value_pln,\r\n",
        "        value_pln_fixed_fx\r\n",
        "    FROM workspace.fin_gold.portfolio_daily\r\n",
        "    ORDER BY date DESC\r\n",
        "    LIMIT 1\r\n",
        "),\r\n",
        "ryzyko AS (\r\n",
        "    SELECT MIN(drawdown) AS max_drawdown\r\n",
        "    FROM workspace.fin_gold.portfolio_daily\r\n",
        "),\r\n",
        "wyniki AS (\r\n",
        "    SELECT cagr_pln\r\n",
        "    FROM workspace.fin_gold.risk_return\r\n",
        "    WHERE instrument_type = 'portfolio'\r\n",
        ")\r\n",
        "SELECT\r\n",
        "    ROUND(o.value_pln, 0)\r\n",
        "        AS wartosc_portfela_pln,\r\n",
        "\r\n",
        "    ROUND((o.value_pln / 100000.0 - 1) * 100, 2)\r\n",
        "        AS zwrot_laczny_proc,\r\n",
        "\r\n",
        "    ROUND(w.cagr_pln * 100, 2)\r\n",
        "        AS cagr_proc,\r\n",
        "\r\n",
        "    ROUND(r.max_drawdown * 100, 2)\r\n",
        "        AS maks_obsuniecie_proc,\r\n",
        "\r\n",
        "    ROUND(o.value_pln_fixed_fx - o.value_pln, 0)\r\n",
        "        AS roznica_kursowa_pln\r\n",
        "FROM ostatni o\r\n",
        "CROSS JOIN ryzyko r\r\n",
        "CROSS JOIN wyniki w;\r\n"
      ]
    }
  ],
