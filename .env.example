# Przykładowa konfiguracja sekretów do uruchomień POZA Databricks (np. lokalnie).
# W Databricks sekrety trzymamy w secret scope "fin-lakehouse" (README.md -> Sekrety).
# Skopiuj do pliku .env (jest w .gitignore) i uzupełnij. NIGDY nie commituj prawdziwych wartości.

# Klucz API Stooq: https://stooq.com/q/d/?s=spy.us&get_apikey
STOOQ_API_KEY=

# SEC EDGAR wymaga identyfikacji: nazwa i adres e-mail, np. "Projekt Inzynieria Danych jan.kowalski@example.com"
SEC_USER_AGENT=
